---
import "../styles/globals.css";
import "../styles/notifications.css";
import { sitePath } from "../utils/sitePath";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  robots?: string;
}

const {
  title = "Yoki Cloud",
  description = "Personal portal and browser start page.",
  canonical,
  image,
  type = "website",
  robots = "index,follow",
} = Astro.props;

const canonicalUrl =
  canonical ??
  (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#05070b" />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <link rel="icon" href={sitePath("/favicon.ico")} sizes="any" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    {image ? <meta property="og:image" content={image} /> : null}
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image ? <meta name="twitter:image" content={image} /> : null}
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stored = window.localStorage.getItem("ark.portal.theme.v1");
          const theme =
            stored === "dark" || stored === "light"
              ? stored
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { installNotifications } from "../utils/notifications";
      installNotifications();
      const key = "yoki.navigation.pending";
      try {
        const nav = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
        if (nav?.type !== "back_forward" && nav?.type !== "reload") {
          const pending = JSON.parse(sessionStorage.getItem(key) || "null");
          const matches = pending?.to === location.href && Date.now() - pending.time < 30000;
          history.replaceState({ ...history.state, yokiSource: matches ? pending.from : document.referrer || null,
            yokiInternal: Boolean(matches && pending.sameTab) }, "");
        }
        sessionStorage.removeItem(key);
      } catch { /* Storage is optional. */ }
      const entrySource = history.state?.yokiSource;
      window.addEventListener("hashchange", () => {
        history.replaceState({ ...history.state, yokiSource: entrySource, yokiInternal: false }, "");
      });
      document.addEventListener("click", (event) => {
        const link = (event.target as Element)?.closest?.("a[href]") as HTMLAnchorElement | null;
        if (!link || link.hasAttribute("download") || link.hasAttribute("data-return")) return;
        const url = new URL(link.href);
        if (url.origin !== location.origin || url.pathname === location.pathname && url.search === location.search) return;
        try {
          sessionStorage.setItem(key, JSON.stringify({ to: url.href, from: location.href, time: Date.now(),
            sameTab: !event.ctrlKey && !event.metaKey && !event.shiftKey && (!link.target || link.target === "_self") }));
        } catch { /* fall back to referrer */ }
      }, true);
    </script>
  </body>
</html>
