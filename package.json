{
  "name": "yoki-cloud",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "admin:publish": "node scripts/publish-admin-content.mjs",
    "admin:publish:dry": "node scripts/publish-admin-content.mjs --skip-build --dry-run",
    "admin:publish-server": "node scripts/admin-publish-server.mjs",
    "algorithms:sync": "node scripts/sync-algorithms.mjs",
    "algorithms:sync:dry": "node scripts/sync-algorithms.mjs --dry-run",
    "algorithms:watch": "node scripts/sync-algorithms.mjs --watch",
    "algorithms:publish": "node scripts/publish-algorithms.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:paths": "node scripts/verify-site-paths.mjs && node scripts/verify-algorithm-ui.mjs && node scripts/verify-local-paths.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/react": "^6.0.1",
    "astro": "^7.0.7",
    "framer-motion": "^11.18.2",
    "katex": "^0.16.45",
    "lucide-react": "^0.441.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^20",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "typescript": "^5"
  },
  "overrides": {
    "yaml": "$yaml"
  }
}
